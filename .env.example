# Wind Forecast Analytics - environment configuration
#
# Copy this file to .env and adjust the values for your machine.
# Only the settings required by the current build stage are listed here;
# further settings are added as the corresponding features are implemented.

# Comma-separated list of frontend origins allowed to call the API.
# 5173 is the Vite dev server; 4173 is `npm run preview` for the production build.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
