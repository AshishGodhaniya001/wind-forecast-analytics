# Frontend configuration
#
# Copy this file to .env and adjust as needed. Vite exposes only variables
# prefixed with VITE_ to the browser, so never put secrets here.
#
# Base URL of the FastAPI backend, without a trailing slash.
# Defaults to http://localhost:8000 when the variable is unset.
# Set it to an empty value to call the API on the same origin as the frontend.
VITE_API_BASE_URL=http://localhost:8000
